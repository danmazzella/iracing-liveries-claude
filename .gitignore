# Allowlist: ignore everything at the top level, then share only what's listed below.
# Liveries live in liveries/: only the example is shared, any new livery stays private
# unless you add it here.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/LIVERY_GUIDE.md
!/requirements.txt
!/install_gui.bat
!/cars/
!/tools/
!/liveries/
!/logos/
!/psd/

# Liveries: only the example is shared
/liveries/*
!/liveries/example/

# Templates: only the README is shared (download the PSDs from iRacing)
/psd/*
!/psd/README.md

# Logos: only the README is shared, logo files stay private
/logos/*
!/logos/README.md

# Never shared, wherever they are:
# iRacing templates (download your own, into psd/), build output, python/OS clutter
*.psd
out/
__pycache__/
*.pyc
.DS_Store
.venv/
CLAUDE.local.md
tools/.customer_id

# Big regenerable files (tools/uvcode.py rebuilds uvcode.tga, tools/seams.py check rebuilds seamcheck.tga)
cars/*/uvcode.tga
cars/*/seamcheck.tga
cars/*/grid_old_*.tga
